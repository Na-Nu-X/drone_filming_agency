# Copy to `.env` and adjust for your environment.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for local SQLite. Production example:
# DATABASE_URL=postgres://drone_user:secret@localhost:5432/drone_agency
DATABASE_URL=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
CSRF_TRUSTED_ORIGINS=

# Rate limit for public quote submissions.
QUOTE_THROTTLE_RATE=20/hour
